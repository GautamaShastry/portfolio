# Who the portfolio belongs to (mirror site.config.js). Used in the AI's instructions,
# emails and spoken prompts. Pronouns: subject/object/possessive.
OWNER_NAME=Your Name
OWNER_FIRST_NAME=Your
OWNER_PRONOUNS=they/them/their
# Optional: your first name in other scripts, by site language (JSON)
# OWNER_LOCALIZED_NAMES={"hi": "...", "te": "..."}
SITE_URL=https://your-domain.com

# AWS Bedrock / Polly - no API keys. Locally, credentials come from your AWS profile
# (aws configure / AWS_PROFILE); in Lambda, from the execution role (see bedrock-policy.json).
BEDROCK_REGION=us-east-1
# Sonnet 4.5 for now; switch to anthropic.claude-haiku-5-5 (and lift the SDK pin) once your account has access
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL=cohere.embed-multilingual-v3

# Origins allowed to call this API (comma-separated)
# Optional: defaults to SITE_URL, its www version, and local dev servers
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost:3001

# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service-role key only - never expose this client-side. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin CMS auth
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-chosen-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=your_random_secret_here

# Conversation transcripts emailed via Amazon SES. Verify the sender address (and, while
# SES is in sandbox mode, the recipient too) under SES -> Identities.
TRANSCRIPT_NOTIFY_EMAIL=you@example.com
TRANSCRIPT_SENDER_EMAIL=you@example.com
SES_REGION=us-east-1
# Conversations idle this long are emailed by the scheduled sweep if the browser never reported the end
TRANSCRIPT_IDLE_MINUTES=15
