# Google Analytics 4 measurement ID (analytics.google.com -> Admin -> Data streams). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Chatbot / Voice Agent backend (Lambda Function URL)
VITE_CHATBOT_API_URL=https://your-lambda-function-url.lambda-url.us-east-1.on.aws

# Supabase (public anon key - safe to expose, blog reads are gated by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# RAG reindex (scripts/reindex.mjs, run locally or in CodeBuild - NOT exposed to the browser)
# Embeddings use Bedrock (Cohere Embed Multilingual v3) via your AWS credentials (AWS_PROFILE locally, the CodeBuild role in CI).
BEDROCK_REGION=us-east-1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
