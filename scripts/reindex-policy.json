{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReindexEmbeddings",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/cohere.embed-multilingual-v3"
    },
    {
      "Sid": "ReadBuildSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*:*:parameter/CodeBuild/portfolio/*"
    },
    {
      "Sid": "DecryptBuildSecrets",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "*",
      "Condition": {"StringEquals": {"kms:ViaService": "ssm.us-east-1.amazonaws.com"}}
    }
  ]
}
